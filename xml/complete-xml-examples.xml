<?xml version="1.0" encoding="UTF-8"?>

<!--
    ============================================================
    XML Learning File
    ------------------------------------------------------------
    Purpose:
      Ek beginner-friendly XML file jo common XML concepts
      cover karti hai - elements, attributes, nesting,
      repeated elements, comments, CDATA, entities, etc.

    Yeh file padh ke tum samajh jaoge:
      - XML ka structure kaisa hota hai
      - Elements aur attributes mein difference kya hai
      - Nested data kaise represent hota hai
      - Comments kaise likhe jaate hain
      - Special characters ka kya karna hai
      - CDATA ka use kab hota hai

    Author: Dheerendra Singh
    Goal: Learning reference for students
    ============================================================
-->

<!-- Root element: har XML file mein ek hi root element hota hai -->
<learningProject>

    <!-- Project metadata using attributes -->
    <project id="XML-001" type="learning" status="active">

        <!-- Basic project information -->
        <name>XML Learning Project</name>
        <description>
            Ek simple XML file jisme hum XML ke basic concepts
            ko practically dikhate hain. Isse padh ke koi bhi
            student XML ko scratch se seekh sakta hai.
        </description>

        <!-- Author information (nested elements) -->
        <author>
            <name>Dheerendra Singh</name>
            <role>Software Engineering Student</role>
            <email>dheerendra@example.com</email>
        </author>

        <!-- Repeated elements: XML mein list aise banate hain -->
        <technologies>
            <technology>HTML</technology>
            <technology>CSS</technology>
            <technology>JavaScript</technology>
            <technology>Node.js</technology>
            <technology>JSON</technology>
            <technology>YAML</technology>
            <technology>XML</technology>
        </technologies>

        <!-- Learning topics with attributes (metadata) -->
        <learningTopics>

            <topic id="1" level="beginner">
                <title>What is XML?</title>
                <description>
                    XML ka matlab hai Extensible Markup Language.
                    Yeh data ko store aur transport karne ke liye
                    use hota hai. XML self-descriptive hota hai.
                </description>
            </topic>

            <topic id="2" level="beginner">
                <title>XML Elements</title>
                <description>
                    Elements XML ke main building blocks hain.
                    Example: &lt;name&gt;Dheerendra&lt;/name&gt;
                </description>
            </topic>

            <topic id="3" level="beginner">
                <title>XML Attributes</title>
                <description>
                    Attributes element ke baare mein extra
                    information dete hain.
                    Example: id="101" ya level="beginner".
                </description>
            </topic>

            <topic id="4" level="intermediate">
                <title>XML Nesting</title>
                <description>
                    Elements ke andar elements rakh ke hum
                    hierarchical data bana sakte hain.
                </description>
            </topic>

            <topic id="5" level="intermediate">
                <title>XML CDATA</title>
                <description>
                    CDATA ka use tab hota hai jab humein content
                    mein special characters escape na karna pade.
                </description>
            </topic>

            <topic id="6" level="advanced">
                <title>XML Validation (XSD)</title>
                <description>
                    XSD se hum XML ko ek defined structure ke
                    against validate kar sakte hain.
                </description>
            </topic>

        </learningTopics>

        <!-- Settings: key-value pairs using attributes -->
        <settings>
            <setting key="version" value="1.0" />
            <setting key="language" value="en" />
            <setting key="format" value="xml" />
            <setting key="created" value="2025-01-01" />
            <setting key="selfClosing" value="true" />
        </settings>

        <!-- Example data for comparing XML with JSON and YAML -->
        <studentExample>
            <student id="101" active="true">
                <name>Dheerendra</name>
                <age>20</age>
                <course>Software Engineering</course>
                <skills>
                    <skill>JavaScript</skill>
                    <skill>React</skill>
                    <skill>Node.js</skill>
                    <skill>MongoDB</skill>
                </skills>
                <address>
                    <city>Delhi</city>
                    <state>Delhi</state>
                    <country>India</country>
                </address>
            </student>

            <student id="102" active="true">
                <name>Rahul</name>
                <age>22</age>
                <course>Computer Science</course>
                <skills>
                    <skill>Python</skill>
                    <skill>Django</skill>
                    <skill>PostgreSQL</skill>
                </skills>
                <address>
                    <city>Mumbai</city>
                    <state>Maharashtra</state>
                    <country>India</country>
                </address>
            </student>
        </studentExample>

        <!-- Entities example: special characters ko escape karna -->
        <entitiesExample>
            <!-- &lt; ka matlab < -->
            <!-- &gt; ka matlab > -->
            <!-- &amp; ka matlab & -->
            <!-- &quot; ka matlab " -->
            <!-- &apos; ka matlab ' -->
            <message>
                Use &lt;div&gt; tag for containers and
                use &amp; for special meaning.
                Quote example: &quot;Hello World&quot;
            </message>
        </entitiesExample>

        <!-- CDATA example: code ya text jisme special characters ho -->
        <codeExample>
            <codeSnippet language="javascript"><![CDATA[
const x = 10;

if (x < 20 && x > 5) {
    console.log("Value is between 5 and 20");
    console.log("<p>This is HTML inside JS</p>");
}

// Note: upar wale < aur & characters ko escape nahi karna pada
// kyunki yeh CDATA block ke andar hai.
]]></codeSnippet>

            <codeSnippet language="xml"><![CDATA[
<note>
    <to>Students</to>
    <from>Teacher</from>
    <body>Learn XML step by step</body>
</note>
]]></codeSnippet>
        </codeExample>

        <!-- Empty elements (self-closing tags) -->
        <metadata>
            <createdBy value="Dheerendra Singh" />
            <createdAt value="2025-01-01T00:00:00" />
            <tags value="xml,learning,beginner" />
            <difficulty value="beginner" />
        </metadata>

        <!-- Summary of XML features demonstrated -->
        <summary>
            <feature>XML Declaration</feature>
            <feature>Comments</feature>
            <feature>Root Element</feature>
            <feature>Nested Elements</feature>
            <feature>Attributes</feature>
            <feature>Repeated Elements</feature>
            <feature>Self-closing Tags</feature>
            <feature>XML Entities</feature>
            <feature>CDATA Sections</feature>
        </summary>

    </project>

</learningProject> 